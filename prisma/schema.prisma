// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  profiles             Profile[]
  players              Player[]
  subscriptions        Subscription[]
  attendances          Attendance[]
  weightLogs           WeightLog[]
  progress             PlayerProgress[]
  payments             Payment[]
  tournaments          Tournament[]
  sports               Sport[]
  products             Product[]
  productSales         ProductSale[]
  productRestocks      ProductRestock[]
  skills               Skill[]
  skillRatings         SkillRating[]
  registrationRequests RegistrationRequest[]
  events               Event[]
  auditLogs            AuditLog[]
  tournamentEvents TournamentEvent[]
  mediaAlbums MediaAlbum[]
  featuredPlayers FeaturedPlayer[]
  academyInfo AcademyInfo?
  newsPosts   NewsPost[]
  belts Belt[]
  nutritionPrograms NutritionProgram[]
}

enum Role {
  ADMIN
  COACH
  PLAYER
  SECRETARY
}

model Profile {
  id       String @id @default(uuid())
  fullName String
  phone    String @unique
  role     Role

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  players     Player[]
  coachSports CoachSport[]
  tournaments Tournament[]

  // ==== حقول خاصة بصفحة المدرب العامة ====
  avatarUrl         String?
  bio               String?  // نبذة عن المدرب
  title             String?  // الوظيفة: "مدرب ساندا - مدرب كيك بوكسينج"
  yearsExperience   Int?
  playersTrained    Int?
  belts             String?  // الأحزمة/الدرجات
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  whatsapp          String?
  facebookUrl       String?
  instagramUrl      String?
  trainingSchedule  String?  // أيام ومواعيد التدريب

  achievements  CoachAchievement[]
  certificates  CoachCertificate[]
  galleryItems  CoachGalleryItem[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([role])
}

model CoachAchievement {
  id       String  @id @default(uuid())
  coachId  String
  coach    Profile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  title    String  // مثال: "بطولة الجمهورية 2025"
  year     Int?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([coachId])
}

model CoachCertificate {
  id       String  @id @default(uuid())
  coachId  String
  coach    Profile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  title    String
  imageUrl String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([coachId])
}

enum GalleryType {
  IMAGE
  VIDEO
}

model CoachGalleryItem {
  id       String      @id @default(uuid())
  coachId  String
  coach    Profile     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  type     GalleryType
  url      String
  caption  String?
  order    Int         @default(0)

  createdAt DateTime @default(now())

  @@index([coachId])
}

model Player {
  id                 String    @id @default(uuid())
  fullName           String
  phone              String?   @unique 
  playerCode         String?   @unique 
  email              String?   
  userId             String?   @unique
  birthDate          DateTime?
  sportsBackground   String?
  medicalCheckExpiry DateTime?
  joinDate           DateTime? @default(now())
  
  avatarUrl          String?
  currentBelt        String?
  targetBelt         String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  coachId String?
  coach   Profile? @relation(fields: [coachId], references: [id])

  subscriptions Subscription[]
  attendances   Attendance[]
  weightLogs    WeightLog[]
  progress      PlayerProgress[]
  payments      Payment[]
  tournaments   Tournament[]
  sports        PlayerSport[]
  skillRatings  SkillRating[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([coachId])
  @@index([phone])
  @@index([playerCode])
}

model Sport {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  players       PlayerSport[]
  coaches       CoachSport[]
  attendances   Attendance[]
  weightLogs    WeightLog[]
  progress      PlayerProgress[]
  skills        Skill[]
  events        Event[]
  tournaments   Tournament[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}
model PlayerSport {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sportId  String
  sport    Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([playerId, sportId])
}

model CoachSport {
  id       String  @id @default(uuid())
  coachId  String
  coach    Profile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sportId  String
  sport    Sport   @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([coachId, sportId])
}

model Subscription {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  totalSessions    Int
  remaining        Int
  sessionsPerWeek  Int?
  sessionsPerMonth Int?

  totalAmount     Decimal  @db.Decimal(10, 2) @default(0)
  paidAmount      Decimal  @db.Decimal(10, 2) @default(0)
  remainingAmount Decimal  @db.Decimal(10, 2) @default(0)
  paymentStatus   String   @default("PAID")

  startDate     DateTime @default(now())
  endDate       DateTime
  
  isFrozen  Boolean   @default(false)
  frozenAt  DateTime?
  
  payments Payment[]

  createdAt DateTime @default(now())

  @@index([tenantId, playerId])
  @@index([playerId, endDate])
  @@index([sportId])
}

model Attendance {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  date         DateTime @default(now())
  present      Boolean
  recordedById String?   

  coachNote String?

  @@unique([playerId, sportId, date])
  @@index([tenantId, date])
  @@index([playerId, date])
}

model WeightLog {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  weightKg Float
  date     DateTime @default(now())

  @@index([tenantId, playerId])
}

model PlayerProgress {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  skillRating Int
  coachNote   String?
  date        DateTime @default(now())

  @@index([tenantId, playerId])
}

model Skill {
  id       String @id @default(uuid())
  sportId  String
  sport    Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  name     String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ratings  SkillRating[]

  createdAt DateTime @default(now())

  @@index([sportId])
}

model SkillRating {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  value    Float
  date     DateTime @default(now())

  @@index([playerId])
  @@index([skillId])
}

enum PaymentSource {
  SUBSCRIPTION
  MANUAL
  PRODUCT_SALE
  OTHER
}

enum PaymentStatus {
  ACTIVE
  CANCELLED
  REFUNDED
}

model Payment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(10, 2)
  source      PaymentSource
  description String?
  date        DateTime      @default(now())
  status      PaymentStatus @default(ACTIVE)

  productSale ProductSale?

  @@index([tenantId, date])
  @@index([playerId, date])
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name           String
  defaultPrice   Decimal? @db.Decimal(10, 2)
  totalPurchased Int      @default(0)
  totalSold      Int      @default(0)

  sales    ProductSale[]
  restocks ProductRestock[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ProductRestock {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quantity Int
  date     DateTime @default(now())

  @@index([tenantId])
}

model ProductSale {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quantity     Int
  pricePerUnit Decimal? @db.Decimal(10, 2)
  totalAmount  Decimal? @db.Decimal(10, 2)
  date         DateTime @default(now())

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Tournament {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  name     String
  year     Int
  result   String?
  sportId  String
  sport    Sport    @relation(fields: [sportId], references: [id])
  coachId  String?
  coach    Profile? @relation(fields: [coachId], references: [id])

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model RegistrationRequest {
  id          String   @id @default(cuid())
  tenantId    String
  fullName    String
  age         Int
  phone       String
  governorate String
  sport       String
  level       String
  hasCompeted Boolean  @default(false)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  email       String?
  password    String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

enum EventType {
  TRAINING
  TOURNAMENT
  TEST
  ACTIVITY
  MATCH
  MEETING
  CAMP
  OTHER
}

model Event {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  title    String
  type     EventType
  date     DateTime
  time     String?
  location String?
  category String?
  notes    String?

  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, date])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  userRole  String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
model TournamentEvent {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  name         String
  date         DateTime
  location     String?
  description  String?

  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  media        TournamentMedia[]
  participants TournamentParticipant[]

  createdAt    DateTime @default(now())

  @@index([tenantId])
}

enum TournamentMediaType {
  IMAGE
  VIDEO
}

model TournamentMedia {
  id                String              @id @default(uuid())
  tournamentEventId String
  tournamentEvent   TournamentEvent     @relation(fields: [tournamentEventId], references: [id], onDelete: Cascade)

  type              TournamentMediaType
  url               String
  caption           String?
  order             Int                 @default(0)

  createdAt         DateTime            @default(now())

  @@index([tournamentEventId])
}

model TournamentParticipant {
  id                String          @id @default(uuid())
  tournamentEventId String
  tournamentEvent   TournamentEvent @relation(fields: [tournamentEventId], references: [id], onDelete: Cascade)

  name              String
  result            String?
  order             Int             @default(0)

  @@index([tournamentEventId])
}
enum GalleryCategory {
  TOURNAMENTS
  TRAINING
  BELT_TESTS
  CAMPS
  PARTIES
}

enum MediaItemType {
  IMAGE
  VIDEO
}

model MediaAlbum {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  title        String
  category     GalleryCategory
  coverUrl     String?
  isActive     Boolean         @default(true)
  displayOrder Int             @default(0)

  items        MediaAlbumItem[]

  createdAt    DateTime        @default(now())

  @@index([tenantId])
  @@index([category])
}

model MediaAlbumItem {
  id        String        @id @default(uuid())
  albumId   String
  album     MediaAlbum    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  type      MediaItemType
  url       String
  caption   String?
  order     Int           @default(0)

  createdAt DateTime      @default(now())

  @@index([albumId])
}
model FeaturedPlayer {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  season       Int
  name         String
  imageUrl     String?
  sport        String?
  reason       String?  // سبب التميز
  achievement  String?  // الإنجاز

  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([season])
}
model AcademyInfo {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  aboutText        String?
  trainingSchedule String?
  activitiesText   String?
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  mapUrl           String?
  facebookUrl      String?
  instagramUrl     String?

  updatedAt        DateTime @updatedAt
}

model NewsPost {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  title        String
  content      String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([tenantId])
}
model Belt {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  name         String
  color        String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([tenantId])
}
model NutritionProgram {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  title        String
  content      String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([tenantId])
}